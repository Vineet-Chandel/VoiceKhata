# ==============================================================================
# VoiceKhata Backend Environment Variables Example (.env.example)
# ==============================================================================

# Server Port (Render sets this automatically to 10000 or custom)
PORT=3001
NODE_ENV=production

# ── AI API Keys (REQUIRED for Receipt Scanning & Media Import) ─────────────────
# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Optional Fallback Vision Model (OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# ── CORS / Allowed Origins ───────────────────────────────────────────────────
# Comma-separated allowed frontend origins for production CORS
FRONTEND_URL=https://voicekhata.tech,https://www.voicekhata.tech
ALLOWED_ORIGINS=https://voicekhata.tech,https://www.voicekhata.tech

# ── Supabase (Database & Auth) ────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Market Data & Search APIs ─────────────────────────────────────────────────
TWELVE_DATA_KEY=your_twelve_data_api_key
TAVILY_API_KEY=your_tavily_api_key

# ── Google OAuth / Gmail Sync ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GMAIL_REDIRECT_URI=https://api.voicekhata.tech/auth/gmail/callback
